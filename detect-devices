#!/usr/bin/env bash
#
# Detect hardware that Kismet can use. Run this BEFORE install-kismet.
#
# It needs no root and does not require Kismet to be installed. It prints a
# report and writes ./kismet-sources.list (one Kismet data source per line).
# install-kismet reads that file and adds the sources to
# /etc/kismet/kismet_site.conf.
#
# Review/edit kismet-sources.list before installing. Lines starting with '#'
# are ignored; uncomment alternatives you want.
#
# Usage:   ./detect-devices [output-file]

set -uo pipefail

OUT="${1:-$(dirname "$(readlink -f "$0")")/kismet-sources.list}"
sources=()
notes=()

say() { printf '%s\n' "$*"; }

# --- Wi-Fi interfaces --------------------------------------------------------
say "== Wi-Fi interfaces =="
found=0
for dev in /sys/class/net/*; do
    ifc="${dev##*/}"
    [[ -d "$dev/wireless" || -d "$dev/phy80211" ]] || continue
    [[ "$ifc" == kismon* || "$ifc" == *mon ]] && continue   # leftover monitor vifs
    found=1
    drv=$(basename "$(readlink -f "$dev/device/driver" 2>/dev/null)" 2>/dev/null)
    bus=pci
    readlink -f "$dev/device" | grep -q '/usb' && bus=usb
    state=$(cat "$dev/operstate" 2>/dev/null)
    mac=$(cat "$dev/address" 2>/dev/null)
    say "  $ifc  driver=${drv:-?}  bus=$bus  state=$state  mac=$mac"
    sources+=("${ifc}:name=${drv:-wifi}-${ifc}")
done
(( found )) || say "  none"

# Leftover monitor interfaces from earlier manual runs can block the real one.
for dev in /sys/class/net/kismon*; do
    [[ -e "$dev" ]] || continue
    notes+=("Stale monitor interface ${dev##*/} exists (from a manual Kismet run); remove with: sudo ip link delete ${dev##*/}")
done

# --- Bluetooth ---------------------------------------------------------------
say; say "== Bluetooth adapters =="
found=0
for dev in /sys/class/bluetooth/hci*; do
    [[ -e "$dev" && "${dev##*/}" != *:* ]] || continue
    found=1
    say "  ${dev##*/}"
    sources+=("${dev##*/}:type=linuxbluetooth")
done
(( found )) || say "  none"

# --- USB radios --------------------------------------------------------------
say; say "== USB radios / SDR / dongles =="
found=0
rtl=0
uber=0
if command -v lsusb >/dev/null; then
    while read -r _ bus _ dev _ id desc; do
        case "$id" in
            0bda:2832|0bda:2838)
                found=1; say "  RTL-SDR        $id  $desc"
                sources+=("# rtl_433 sensors (one dongle can do ONE of rtl433 / rtladsb):"
                          "# rtl433-${rtl}"
                          "# rtladsb-${rtl}")
                rtl=$((rtl+1)) ;;
            1d50:6002)
                found=1; say "  Ubertooth One  $id  $desc"
                sources+=("ubertooth-${uber}:type=ubertooth"); uber=$((uber+1)) ;;
            1d50:6089)
                found=1; say "  HackRF One     $id  $desc (no native Kismet source; not added)" ;;
            2cf0:5250|2cf0:5246|1d50:6066)
                found=1; say "  bladeRF        $id  $desc"
                notes+=("bladeRF found: add a source such as 'bladerf-0:type=bladerf' only if you use the bladerf_wiphy helper") ;;
            0451:16a8|0451:16b3)
                found=1; say "  TI CC25xx      $id  $desc"
                sources+=("# ${id} TI CC25xx 802.15.4 / Zigbee: see Kismet docs for the correct source name") ;;
        esac
    done < <(lsusb)
    (( found )) || say "  none recognised"
else
    say "  lsusb not found (sudo apt install usbutils)"
fi

# --- Permissions hints -------------------------------------------------------
say; say "== Notes =="
(( ${#notes[@]} )) || say "  none"
for n in "${notes[@]}"; do say "  - $n"; done
if (( rtl + uber )); then
    say "  - USB radios are root:plugdev via udev; install-kismet adds the service user to plugdev."
    say "  - The RTL-SDR needs the rtl-sdr udev rules (apt: rtl-sdr) and, for rtl433, the rtl-433 package."
fi

# --- Output ------------------------------------------------------------------
{
    say "# Generated by detect-devices on $(date -u +%FT%TZ) for $(hostname)"
    say "# Read by install-kismet. One Kismet 'source=' value per line."
    printf '%s\n' "${sources[@]}"
} > "$OUT"

say; say "Wrote ${OUT}:"; sed 's/^/  /' "$OUT"
say; say "Edit it if needed, then run: sudo ./install-kismet"
